<Page
    x:Class="Jm.Uwp.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jm.Uwp"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Black">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" Background="#202020" Foreground="White">
            <AppBarButton Icon="Back" Label="返回" Click="Back_Click" Foreground="White" />
            <AppBarButton Icon="List" Label="目录" Foreground="White">
                <AppBarButton.Flyout>
                    <Flyout>
                        <ListView x:Name="TocList" Width="200" MaxHeight="420"
                                  IsItemClickEnabled="True" ItemClick="Toc_ItemClick" />
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Favorite" Label="书签" Click="Bookmark_Click" Foreground="White" />
            <AppBarButton x:Name="DownloadButton" Icon="Download" Label="下载本章" Click="Download_Click" Foreground="White" />
            <CommandBar.Content>
                <TextBlock x:Name="TitleText" Foreground="White" Margin="12,0" VerticalAlignment="Center" />
            </CommandBar.Content>
        </CommandBar>

        <!-- 阅读区：竖向连续，条目拉满宽度(自动对齐窗口)，整体可缩放。
             按需加载：只解码可见的几页，滚出视图即释放，避免整章一次性解码爆内存闪退。 -->
        <ListView Grid.Row="1" x:Name="PageHost" ItemsSource="{x:Bind Pages}"
                  SelectionMode="None" Padding="0"
                  ContainerContentChanging="PageHost_ContainerContentChanging"
                  ScrollViewer.ZoomMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollMode="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ReaderPageItem">
                    <Grid MinHeight="200" Background="#0A0A0A">
                        <ProgressRing Width="32" Height="32" Foreground="#888888"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      IsActive="True" Visibility="{x:Bind SpinnerVisibility, Mode=OneWay}" />
                        <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Uniform" HorizontalAlignment="Stretch" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 进度条：拖动跳页 -->
        <Grid Grid.Row="2" Background="#202020" Padding="12,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="PageSlider" Grid.Column="0" Minimum="1" Maximum="1" Value="1"
                    StepFrequency="1" ValueChanged="PageSlider_ValueChanged" VerticalAlignment="Center" />
            <TextBlock x:Name="PageLabel" Grid.Column="1" Foreground="White" Margin="12,0,0,0"
                       VerticalAlignment="Center" Text="0/0" />
        </Grid>

        <StackPanel x:Name="StatusPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressRing x:Name="Busy" Width="48" Height="48" IsActive="True" Foreground="White" />
            <TextBlock x:Name="StatusText" Foreground="White" HorizontalAlignment="Center"
                       Margin="0,8,0,0" Text="加载中…" />
        </StackPanel>
    </Grid>
</Page>
