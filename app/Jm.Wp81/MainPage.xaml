<phone:PhoneApplicationPage
    x:Class="Jm.Wp81.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <phone:PhoneApplicationPage.Resources>
        <!-- 专辑卡片模板 -->
        <DataTemplate x:Key="AlbumTemplate">
            <StackPanel Margin="0,0,0,12">
                <Grid Width="150" Height="200" Margin="4">
                    <Border Background="#22000000">
                        <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" />
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Name}" FontSize="16" MaxHeight="40" TextWrapping="Wrap" Margin="4,4,4,0" />
                <TextBlock Text="{Binding Author}" FontSize="14" Foreground="Gray" Margin="4,0,4,4" />
            </StackPanel>
        </DataTemplate>
    </phone:PhoneApplicationPage.Resources>

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题面板 -->
        <StackPanel x:Name="TitlePanel" Grid.Row="0" Margin="12,17,0,28">
            <TextBlock Text="JM READER" Style="{StaticResource PhoneTextNormalStyle}" Margin="12,0"/>
            <TextBlock Text="禁漫阅读器" Margin="9,-7,0,0" Style="{StaticResource PhoneTextTitle1Style}"/>
        </StackPanel>

        <!-- 主内容 -->
        <phone:Pivot Grid.Row="1" x:Name="MainPivot" Title="" SelectionChanged="Pivot_SelectionChanged">
            <!-- 搜索页 -->
            <phone:PivotItem Header="搜索">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索框 -->
                    <TextBox x:Name="SearchBox" Grid.Row="0" PlaceholderText="输入搜索关键词..."
                             KeyDown="SearchBox_KeyDown" Margin="0,0,0,12"/>

                    <!-- 分类选择 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="分类：" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <phone:LongListSelector x:Name="CategoryList"
                                                SelectionChanged="CategoryList_SelectionChanged"
                                                LayoutMode="Grid" GridCellSize="100,50"
                                                ItemsSource="{Binding Categories}"
                                                Height="50">
                            <phone:LongListSelector.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource PhoneAccentBrush}"
                                            BorderThickness="2" Margin="2" Padding="8,4">
                                        <TextBlock Text="{Binding}" FontSize="16"/>
                                    </Border>
                                </DataTemplate>
                            </phone:LongListSelector.ItemTemplate>
                        </phone:LongListSelector>
                    </StackPanel>

                    <!-- 排序和搜索按钮 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="排序：" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <phone:ListPicker x:Name="OrderPicker"
                                         SelectionChanged="OrderPicker_SelectionChanged"
                                         Width="200">
                            <phone:ListPickerItem Content="综合"/>
                            <phone:ListPickerItem Content="最新"/>
                            <phone:ListPickerItem Content="最多点击"/>
                            <phone:ListPickerItem Content="最多爱心"/>
                            <phone:ListPickerItem Content="最多图片"/>
                        </phone:ListPicker>
                        <Button Content="搜索" Click="SearchButton_Click" Margin="12,0,0,0"/>
                    </StackPanel>

                    <!-- 搜索结果 -->
                    <Grid Grid.Row="3">
                        <ProgressBar x:Name="SearchProgress" IsIndeterminate="True"
                                    Visibility="Collapsed" VerticalAlignment="Top"/>
                        <TextBlock x:Name="StatusText" Text="输入关键词开始搜索"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="Gray" TextWrapping="Wrap"/>
                        <phone:LongListSelector x:Name="ResultList"
                                               SelectionChanged="ResultList_SelectionChanged"
                                               ItemTemplate="{StaticResource AlbumTemplate}"
                                               LayoutMode="Grid" GridCellSize="160,280"/>
                    </Grid>
                </Grid>
            </phone:PivotItem>

            <!-- 收藏页 -->
            <phone:PivotItem Header="收藏">
                <Grid>
                    <TextBlock x:Name="FavEmpty" Text="还没有收藏"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="Gray" Visibility="Collapsed"/>
                    <phone:LongListSelector x:Name="FavList"
                                           SelectionChanged="FavList_SelectionChanged"
                                           ItemTemplate="{StaticResource AlbumTemplate}"
                                           LayoutMode="Grid" GridCellSize="160,280"/>
                </Grid>
            </phone:PivotItem>

            <!-- 历史页 -->
            <phone:PivotItem Header="历史">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="清空历史" Click="ClearHistory_Click"
                           HorizontalAlignment="Right" Margin="0,0,0,12"/>
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="HistEmpty" Text="还没有浏览历史"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="Gray" Visibility="Collapsed"/>
                        <phone:LongListSelector x:Name="HistList"
                                               SelectionChanged="HistList_SelectionChanged"
                                               ItemTemplate="{StaticResource AlbumTemplate}"
                                               LayoutMode="Grid" GridCellSize="160,280"/>
                    </Grid>
                </Grid>
            </phone:PivotItem>
        </phone:Pivot>
    </Grid>

    <!-- 应用栏 -->
    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar IsVisible="True" IsMenuEnabled="True">
            <shell:ApplicationBarIconButton IconUri="/Assets/AppBar/favs.png" Text="书签" Click="Bookmarks_Click"/>
            <shell:ApplicationBarIconButton IconUri="/Assets/AppBar/feature.settings.png" Text="设置" Click="Settings_Click"/>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>

</phone:PhoneApplicationPage>
