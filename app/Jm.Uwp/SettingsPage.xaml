<Page
    x:Class="Jm.Uwp.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="12,12,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Button Content="← 返回" Click="Back_Click" HorizontalAlignment="Left" />
            <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="图片并发加载数" FontSize="16" />
                    <TextBlock Text="阅读时同时下载多少张图。越大越快，太大可能被服务器限流。"
                               FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,4" />
                    <Slider x:Name="ConcurrencySlider" Minimum="1" Maximum="16" StepFrequency="1"
                            TickFrequency="1" ValueChanged="Concurrency_ValueChanged" />
                    <TextBlock x:Name="ConcurrencyValue" FontSize="13" Foreground="Gray" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="API 域名" FontSize="16" />
                    <TextBlock x:Name="DomainText" FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,4" />
                    <Button x:Name="RefreshDomainButton" Content="从发布页更新域名" Click="RefreshDomain_Click" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="数据" FontSize="16" />
                    <Button Content="清空浏览历史" Click="ClearHistory_Click" Margin="0,4,0,0" />
                </StackPanel>

                <TextBlock x:Name="VersionText" FontSize="12" Foreground="Gray" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
